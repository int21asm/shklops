{
  "name": "shklops",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development node --env-file-if-exists=.env --watch server/index.js",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "start:live": "node --env-file-if-exists=.env start-live.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:browser": "node tests/browser.mjs && node tests/sankey-browser.mjs"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "dependencies": {
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "israeli-bank-scrapers": "file:vendor/israeli-bank-scrapers",
    "jose": "^6.2.13",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.4.1",
    "playwright": "1.55.1",
    "supertest": "^7.1.4"
  }
}
